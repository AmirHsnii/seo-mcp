# Auth: oauth = multi-user Google OAuth for ChatGPT
#        bearer = static MCP_ACCESS_TOKEN (Claude)
#        none = no MCP auth (dev only)
MCP_AUTH_MODE=oauth
MCP_AUTH_ENABLED=false

# Only used when MCP_AUTH_MODE=bearer
MCP_ACCESS_TOKEN=

# Google OAuth 2.0 Web application client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mcp.bpseo.ir/oauth/google/callback

# Public URL of this MCP server
MCP_BASE_URL=

# Secret for signing MCP access tokens (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
MCP_OAUTH_JWT_SECRET=

# Optional extra Host headers (comma-separated) for DNS-rebinding allow-list
# MCP_PUBLIC_HOSTS=

PORT=8420
